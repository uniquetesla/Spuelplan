# Vorlage für die IT: Domain und Zertifikatspfade vor Verwendung ersetzen.
# Node ausschließlich hinter diesem HTTPS-Proxy betreiben.
server {
    listen 80;
    server_name spuelpilot.example;
    return 301 https://$host$request_uri;
}
server {
    listen 443 ssl;
    server_name spuelpilot.example;
    ssl_certificate /etc/letsencrypt/live/spuelpilot.example/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/spuelpilot.example/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    client_max_body_size 32k;
    location / {
        proxy_pass http://127.0.0.1:3000;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }
}
